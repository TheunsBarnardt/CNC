<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Desktop.Converters"
             x:Class="Desktop.Controls.Toolbars.EditToolbar"
             x:CompileBindings="False"
             IsVisible="{Binding SelectedPart, Converter={x:Static conv:NotNullConverter.Instance}}">

  <Border Background="{StaticResource Brush.Bg2}"
          BorderBrush="{StaticResource Brush.Border}"
          BorderThickness="0,1,0,0"
          Padding="8,4">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="4">

        <!-- X / Y -->
        <TextBlock Text="X" Classes="muted" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <TextBox x:Name="TbX" Width="60" LostFocus="OnTransformChanged"/>
        <TextBlock Text="Y" Classes="muted" VerticalAlignment="Center" Margin="8,0,2,0"/>
        <TextBox x:Name="TbY" Width="60" LostFocus="OnTransformChanged"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Width / Height -->
        <TextBlock Text="W" Classes="muted" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <TextBox x:Name="TbW" Width="60" LostFocus="OnSizeChanged"/>
        <Button Theme="{StaticResource Btn.Icon}" Width="24" Height="24"
                x:Name="BtnLock" Click="OnToggleLock" ToolTip.Tip="Lock aspect ratio">
          <PathIcon Data="{StaticResource Icon.Lock}" Width="13" Height="13"/>
        </Button>
        <TextBlock Text="H" Classes="muted" VerticalAlignment="Center" Margin="2,0,2,0"/>
        <TextBox x:Name="TbH" Width="60" LostFocus="OnSizeChanged"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Rotation -->
        <PathIcon Data="{StaticResource Icon.Angle}" Width="13" Height="13" Classes="muted" VerticalAlignment="Center"/>
        <TextBox x:Name="TbRot" Width="50" LostFocus="OnRotChanged"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- ── Arrange flyout ── -->
        <Button x:Name="BtnArrange" Theme="{StaticResource Btn.Ghost}" Padding="8,5">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource Icon.Front}" Width="14" Height="14"/>
            <TextBlock Text="Arrange" VerticalAlignment="Center"/>
            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.6"/>
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuItem Header="Bring to front" Click="OnBringToFront">
                <MenuItem.InputGesture><KeyGesture>OemCloseBrackets</KeyGesture></MenuItem.InputGesture>
              </MenuItem>
              <MenuItem Header="Send backward"  Click="OnSendBackward">
                <MenuItem.InputGesture><KeyGesture>Ctrl+OemOpenBrackets</KeyGesture></MenuItem.InputGesture>
              </MenuItem>
              <MenuItem Header="Bring forward"  Click="OnBringForward">
                <MenuItem.InputGesture><KeyGesture>Ctrl+OemCloseBrackets</KeyGesture></MenuItem.InputGesture>
              </MenuItem>
              <MenuItem Header="Send to back"   Click="OnSendToBack">
                <MenuItem.InputGesture><KeyGesture>OemOpenBrackets</KeyGesture></MenuItem.InputGesture>
              </MenuItem>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- ── Align flyout ── -->
        <Button x:Name="BtnAlign" Theme="{StaticResource Btn.Ghost}" Padding="8,5">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource Icon.AlignLeft}" Width="14" Height="14"/>
            <TextBlock Text="Align" VerticalAlignment="Center"/>
            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.6"/>
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuItem Header="Align left"               Click="OnAlignLeft"/>
              <MenuItem Header="Horizontal align center"  Click="OnAlignHCenter"/>
              <MenuItem Header="Align right"              Click="OnAlignRight"/>
              <Separator/>
              <MenuItem Header="Align top"                Click="OnAlignTop"/>
              <MenuItem Header="Vertical align center"    Click="OnAlignVCenter"/>
              <MenuItem Header="Align bottom"             Click="OnAlignBottom"/>
              <Separator/>
              <MenuItem Header="Align center (sheet)"     Click="OnCenter"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- ── Reflect flyout ── -->
        <Button x:Name="BtnReflect" Theme="{StaticResource Btn.Ghost}" Padding="8,5">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource Icon.MirrorH}" Width="14" Height="14"/>
            <TextBlock Text="Reflect" VerticalAlignment="Center"/>
            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.6"/>
          </StackPanel>
          <Button.Flyout>
            <MenuFlyout Placement="Bottom">
              <MenuItem Header="Reflect horizontally" Click="OnReflectH"/>
              <MenuItem Header="Reflect vertically"   Click="OnReflectV"/>
            </MenuFlyout>
          </Button.Flyout>
        </Button>

        <!-- ── Edit (node editing) ── -->
        <Button x:Name="BtnEdit" Theme="{StaticResource Btn.Ghost}" Padding="8,5"
                Click="OnEnterNodeEdit" ToolTip.Tip="Edit nodes">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource Icon.Pen}" Width="14" Height="14"/>
            <TextBlock Text="Edit" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <!-- ── Offset flyout ── -->
        <Button x:Name="BtnOffset" Theme="{StaticResource Btn.Ghost}" Padding="8,5">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource Icon.Offset}" Width="14" Height="14"/>
            <TextBlock Text="Offset" VerticalAlignment="Center"/>
            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.6"/>
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway">
              <Border Width="270" Padding="14,12" CornerRadius="{StaticResource Radius.Md}"
                      Background="{StaticResource Brush.Bg1}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1">
                <StackPanel Spacing="10">

                  <!-- Direction -->
                  <TextBlock Text="Direction" Classes="muted" FontSize="{StaticResource Font.Xs}"/>
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <CheckBox x:Name="CbExternal" Content="External" IsChecked="True" Click="OnOffsetDirectionChanged"/>
                    <CheckBox x:Name="CbInner"    Content="Inner"    IsChecked="False" Click="OnOffsetDirectionChanged"/>
                  </StackPanel>

                  <!-- Corner style -->
                  <TextBlock Text="Corner style" Classes="muted" FontSize="{StaticResource Font.Xs}"/>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="BtnCornerMiter" Width="48" Height="32" Padding="0"
                            ToolTip.Tip="Sharp corners (miter)"
                            Click="OnCornerMiter">
                      <PathIcon Data="{StaticResource Icon.CornerMiter}" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BtnCornerRound" Width="48" Height="32" Padding="0"
                            ToolTip.Tip="Round corners"
                            Click="OnCornerRound">
                      <PathIcon Data="{StaticResource Icon.CornerRound}" Width="18" Height="18"/>
                    </Button>
                    <Button x:Name="BtnCornerBevel" Width="48" Height="32" Padding="0"
                            ToolTip.Tip="Bevel corners"
                            Click="OnCornerBevel">
                      <PathIcon Data="{StaticResource Icon.CornerBevel}" Width="18" Height="18"/>
                    </Button>
                  </StackPanel>

                  <!-- Offset distance -->
                  <TextBlock Text="Offset distance (mm)" Classes="muted" FontSize="{StaticResource Font.Xs}"/>
                  <Grid ColumnDefinitions="*,60">
                    <Slider Grid.Column="0" x:Name="SliderOffset" Minimum="0.1" Maximum="50"
                            Value="2" TickFrequency="0.1"
                            VerticalAlignment="Center" Margin="0,0,8,0"
                            ValueChanged="OnOffsetSliderChanged"/>
                    <TextBox Grid.Column="1" x:Name="TbOffsetDist" Text="2"
                             LostFocus="OnOffsetDistChanged" TextAlignment="Right"/>
                  </Grid>

                  <!-- Outer shapes only -->
                  <CheckBox x:Name="CbOuterOnly" Content="Outer shapes only"/>

                  <!-- Buttons -->
                  <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                    <Button Grid.Column="1" Content="Cancel" Padding="12,6" Margin="0,0,6,0"
                            Click="OnOffsetCancel"/>
                    <Button Grid.Column="2" Content="Confirm" Padding="12,6"
                            Theme="{StaticResource Btn.Primary}"
                            Click="OnOffsetConfirm"/>
                  </Grid>

                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Layer -->
        <TextBlock Text="Layer" Classes="muted" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <ComboBox x:Name="CbLayer" Width="100" SelectionChanged="OnLayerChanged"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- ── Tabs flyout (plasma holding tabs) ── -->
        <Button x:Name="BtnTabs" Theme="{StaticResource Btn.Ghost}" Padding="8,5">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <PathIcon Data="{StaticResource Icon.Scissors}" Width="14" Height="14"/>
            <TextBlock Text="Tabs" VerticalAlignment="Center"/>
            <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center" Opacity="0.6"/>
          </StackPanel>
          <Button.Flyout>
            <Flyout Placement="Bottom" ShowMode="TransientWithDismissOnPointerMoveAway">
              <Border Width="220" Padding="14,12" CornerRadius="{StaticResource Radius.Md}"
                      Background="{StaticResource Brush.Bg1}"
                      BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1">
                <StackPanel Spacing="10">
                  <TextBlock Text="Holding Tabs" FontSize="{StaticResource Font.Sm}" FontWeight="SemiBold"/>
                  <TextBlock Text="Keep part attached during cut" Classes="muted" FontSize="{StaticResource Font.Xs}" TextWrapping="Wrap"/>

                  <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,8,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Count" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TbTabCount" Text="0" Height="26"
                             ToolTip.Tip="Number of tabs (0 = no tabs)"
                             LostFocus="OnTabCountChanged" KeyDown="OnTabKeyDown"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Width (mm)" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TbTabWidth" Text="5" Height="26"
                             ToolTip.Tip="Width of each tab in mm"
                             LostFocus="OnTabWidthChanged" KeyDown="OnTabKeyDown"/>
                  </Grid>

                  <TextBlock x:Name="TabHint" Text="0 tabs · select a part" Classes="muted"
                             FontSize="{StaticResource Font.Xs}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
            </Flyout>
          </Button.Flyout>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Array -->
        <Button x:Name="BtnArray" Theme="{StaticResource Btn.Icon}" ToolTip.Tip="Create array">
          <PathIcon Data="{StaticResource Icon.Array}" Width="16" Height="16"/>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Duplicate / Delete -->
        <Button Theme="{StaticResource Btn.Icon}" Click="OnDuplicate" ToolTip.Tip="Duplicate">
          <PathIcon Data="{StaticResource Icon.Duplicate}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnDelete"
                Foreground="{StaticResource Brush.Danger}" ToolTip.Tip="Delete">
          <PathIcon Data="{StaticResource Icon.Trash}" Width="15" Height="15"/>
        </Button>

      </StackPanel>
    </ScrollViewer>
  </Border>

</UserControl>
