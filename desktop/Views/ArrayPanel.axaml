<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Desktop.Views.ArrayPanel"
        Title="Create Array"
        Width="450" Height="380"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Spacing="16" Margin="20">

    <TextBlock Text="Array Type" FontSize="16" FontWeight="SemiBold"/>

    <TabControl>
      <!-- Grid Tab -->
      <TabItem Header="Grid">
        <StackPanel Spacing="12" Margin="12">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Rows:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbGridRows" Grid.Row="0" Grid.Column="1" Text="3"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cols:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbGridCols" Grid.Row="1" Grid.Column="1" Text="3"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Spacing (mm):" VerticalAlignment="Center"/>
            <TextBox x:Name="TbGridSpacing" Grid.Row="2" Grid.Column="1" Text="20"/>
          </Grid>
          <CheckBox x:Name="CbAutoStep" Content="Auto-calculate spacing"/>
        </StackPanel>
      </TabItem>

      <!-- Circular Tab -->
      <TabItem Header="Circular">
        <StackPanel Spacing="12" Margin="12">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Count:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbCircularCount" Grid.Row="0" Grid.Column="1" Text="6"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius (mm):" VerticalAlignment="Center"/>
            <TextBox x:Name="TbCircularRadius" Grid.Row="1" Grid.Column="1" Text="50"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Start Angle (°):" VerticalAlignment="Center"/>
            <TextBox x:Name="TbStartAngle" Grid.Row="2" Grid.Column="1" Text="0"/>

            <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" x:Name="CbRotateWithArray" Content="Rotate with array"/>
          </Grid>
        </StackPanel>
      </TabItem>

      <!-- Test Tab -->
      <TabItem Header="Test">
        <StackPanel Spacing="10" Margin="12">
          <TextBlock Text="Power × Speed test grid — each cell gets different settings"
                     Classes="muted" FontSize="11" TextWrapping="Wrap"/>
          <Grid ColumnDefinitions="90,*,14,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="8">
            <!-- Row param (varies down) -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Row param:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbParam1" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3">
              <ComboBoxItem Content="Feed Rate (mm/min)" Tag="FeedRate"/>
              <ComboBoxItem Content="Pierce Delay (s)"   Tag="PierceDelay"/>
              <ComboBoxItem Content="Power (%)"          Tag="Power" IsSelected="True"/>
            </ComboBox>

            <!-- Row range -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="  from → to:" VerticalAlignment="Center" Classes="muted"/>
            <TextBox x:Name="TbParam1From" Grid.Row="1" Grid.Column="1" Text="20"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="–" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="TbParam1To"   Grid.Row="1" Grid.Column="3" Text="100"/>

            <!-- Col param (varies across) -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Col param:" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbParam2" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
              <ComboBoxItem Content="Feed Rate (mm/min)" Tag="FeedRate" IsSelected="True"/>
              <ComboBoxItem Content="Pierce Delay (s)"   Tag="PierceDelay"/>
              <ComboBoxItem Content="Power (%)"          Tag="Power"/>
            </ComboBox>

            <!-- Col range -->
            <TextBlock Grid.Row="3" Grid.Column="0" Text="  from → to:" VerticalAlignment="Center" Classes="muted"/>
            <TextBox x:Name="TbParam2From" Grid.Row="3" Grid.Column="1" Text="1000"/>
            <TextBlock Grid.Row="3" Grid.Column="2" Text="–" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="TbParam2To"   Grid.Row="3" Grid.Column="3" Text="5000"/>

            <!-- Grid size -->
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Rows × Cols:" VerticalAlignment="Center"/>
            <TextBox x:Name="TbTestRows" Grid.Row="4" Grid.Column="1" Text="4"/>
            <TextBlock Grid.Row="4" Grid.Column="2" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            <TextBox x:Name="TbTestCols" Grid.Row="4" Grid.Column="3" Text="4"/>
          </Grid>
          <!-- Download button for test tab -->
          <Button x:Name="BtnDownloadTest" Content="Download test .nc"
                  Theme="{StaticResource Btn.Primary}"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Padding="10,6"
                  Click="OnDownloadTest"
                  ToolTip.Tip="Generate and save G-code for the test grid"/>
        </StackPanel>
      </TabItem>
    </TabControl>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="BtnCancel" Content="Cancel" Padding="12,8"/>
      <Button x:Name="BtnCreate" Content="Create Array" Padding="12,8" Background="#3b82f6" Foreground="White"/>
    </StackPanel>

  </StackPanel>

</Window>
