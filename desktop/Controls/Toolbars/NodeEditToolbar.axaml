<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Desktop.Controls.Toolbars.NodeEditToolbar"
             x:CompileBindings="False"
             IsVisible="False">

  <Border Background="{StaticResource Brush.Bg2}"
          BorderBrush="{StaticResource Brush.Border}"
          BorderThickness="1"
          CornerRadius="8"
          Padding="8,5"
          BoxShadow="0 4 16 0 #55000000">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">

        <!-- ── X / Y node position ── -->
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="14,64" VerticalAlignment="Center">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="X" Classes="muted"
                     VerticalAlignment="Center" FontSize="{StaticResource Font.Xs}" Margin="0,0,4,0"/>
          <TextBox   Grid.Row="0" Grid.Column="1" x:Name="TbNodeX"
                     FontSize="{StaticResource Font.Xs}" Padding="4,2"
                     Margin="0,1" LostFocus="OnNodeXChanged"
                     PlaceholderText="—" IsEnabled="False"/>
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Y" Classes="muted"
                     VerticalAlignment="Center" FontSize="{StaticResource Font.Xs}" Margin="0,0,4,0"/>
          <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TbNodeY"
                     FontSize="{StaticResource Font.Xs}" Padding="4,2"
                     Margin="0,1" LostFocus="OnNodeYChanged"
                     PlaceholderText="—" IsEnabled="False"/>
        </Grid>

        <Separator Theme="{StaticResource Sep.Vertical}" Margin="4,0"/>

        <!-- ── Node alignment (2×3) ── -->
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="24,24,24" VerticalAlignment="Center">
          <Button Grid.Row="0" Grid.Column="0" Theme="{StaticResource Btn.Icon}"
                  Width="22" Height="22" ToolTip.Tip="Align nodes left"
                  Click="OnNodeAlignLeft">
            <PathIcon Data="{StaticResource Icon.AlignLeft}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="0" Grid.Column="1" Theme="{StaticResource Btn.Icon}"
                  Width="22" Height="22" ToolTip.Tip="Align nodes horizontal center"
                  Click="OnNodeAlignHCenter">
            <PathIcon Data="{StaticResource Icon.Center}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="0" Grid.Column="2" Theme="{StaticResource Btn.Icon}"
                  Width="22" Height="22" ToolTip.Tip="Align nodes right"
                  Click="OnNodeAlignRight">
            <PathIcon Data="{StaticResource Icon.AlignRight}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="1" Grid.Column="0" Theme="{StaticResource Btn.Icon}"
                  Width="22" Height="22" ToolTip.Tip="Align nodes top"
                  Click="OnNodeAlignTop">
            <PathIcon Data="{StaticResource Icon.AlignTop}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="1" Grid.Column="1" Theme="{StaticResource Btn.Icon}"
                  Width="22" Height="22" ToolTip.Tip="Align nodes vertical center"
                  Click="OnNodeAlignVCenter">
            <PathIcon Data="{StaticResource Icon.AlignBottom}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="1" Grid.Column="2" Theme="{StaticResource Btn.Icon}"
                  Width="22" Height="22" ToolTip.Tip="Align nodes bottom"
                  Click="OnNodeAlignBottom">
            <PathIcon Data="{StaticResource Icon.AlignBottom}" Width="13" Height="13"/>
          </Button>
        </Grid>

        <Separator Theme="{StaticResource Sep.Vertical}" Margin="4,0"/>

        <!-- ── Node type (2×2) ── -->
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="24,24" VerticalAlignment="Center">
          <Button Grid.Row="0" Grid.Column="0" x:Name="BtnNodeSmooth"
                  Theme="{StaticResource Btn.Icon}" Width="22" Height="22"
                  ToolTip.Tip="Smooth symmetric — equal Bézier handles"
                  Click="OnNodeSmooth">
            <PathIcon Data="{StaticResource Icon.NodeSmooth}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="0" Grid.Column="1" x:Name="BtnNodeSmoothAsym"
                  Theme="{StaticResource Btn.Icon}" Width="22" Height="22"
                  ToolTip.Tip="Smooth asymmetric — tangent Bézier handles"
                  Click="OnNodeSmoothAsym">
            <PathIcon Data="{StaticResource Icon.NodeSmoothAsym}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="1" Grid.Column="0" x:Name="BtnNodeCorner"
                  Theme="{StaticResource Btn.Icon}" Width="22" Height="22"
                  ToolTip.Tip="Corner — sharp with independent handles"
                  Click="OnNodeCorner">
            <PathIcon Data="{StaticResource Icon.NodeCorner}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="1" Grid.Column="1" x:Name="BtnNodeCusp"
                  Theme="{StaticResource Btn.Icon}" Width="22" Height="22"
                  ToolTip.Tip="Cusp — sharp point, no handles"
                  Click="OnNodeCusp">
            <PathIcon Data="{StaticResource Icon.NodeCusp}" Width="13" Height="13"/>
          </Button>
        </Grid>

        <Separator Theme="{StaticResource Sep.Vertical}" Margin="4,0"/>

        <!-- ── Extra tools (2×1) ── -->
        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="24" VerticalAlignment="Center">
          <Button Grid.Row="0" Theme="{StaticResource Btn.Icon}" Width="22" Height="22"
                  ToolTip.Tip="Scale/transform selected nodes" Click="OnNodeTransform">
            <PathIcon Data="{StaticResource Icon.NodeTransform}" Width="13" Height="13"/>
          </Button>
          <Button Grid.Row="1" Theme="{StaticResource Btn.Icon}" Width="22" Height="22"
                  ToolTip.Tip="Add node at midpoint / join endpoints" Click="OnNodeAdd">
            <PathIcon Data="{StaticResource Icon.NodeAdd}" Width="13" Height="13"/>
          </Button>
        </Grid>

        <Separator Theme="{StaticResource Sep.Vertical}" Margin="4,0"/>

        <!-- ── Simplify / Scissors text buttons ── -->
        <StackPanel VerticalAlignment="Center" Spacing="2">
          <Button x:Name="BtnSimplify" Theme="{StaticResource Btn.Ghost}" Padding="6,3"
                  FontSize="{StaticResource Font.Xs}"
                  ToolTip.Tip="Remove redundant nodes (RDP simplification)"
                  Click="OnSimplify">
            Simpl.
          </Button>
          <Button x:Name="BtnScissors" Theme="{StaticResource Btn.Ghost}" Padding="6,3"
                  FontSize="{StaticResource Font.Xs}"
                  ToolTip.Tip="Split path at selected node"
                  Click="OnScissors">
            Sciss.
          </Button>
        </StackPanel>

        <Separator Theme="{StaticResource Sep.Vertical}" Margin="4,0"/>

        <!-- ── Done (green) ── -->
        <Button x:Name="BtnDone" Theme="{StaticResource Btn.Primary}" Padding="10,6"
                Click="OnDone" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon Data="{StaticResource Icon.Check}" Width="12" Height="12"/>
            <TextBlock Text="Done" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

      </StackPanel>
    </ScrollViewer>
  </Border>

</UserControl>
