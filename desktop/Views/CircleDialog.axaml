<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Desktop.Views.CircleDialog"
        Title="Create Circle"
        Width="350" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Spacing="16" Margin="20">

    <TextBlock Text="Circle" FontSize="18" FontWeight="SemiBold"/>

    <StackPanel Spacing="8">
      <TextBlock Text="Radius (mm):"/>
      <TextBox x:Name="TbRadius" Text="50"/>
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="BtnCancel" Content="Cancel" Padding="12,8"/>
      <Button x:Name="BtnCreate" Content="Create" Padding="12,8" Background="#3b82f6" Foreground="White"/>
    </StackPanel>

  </StackPanel>

</Window>
