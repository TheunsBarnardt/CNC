<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Desktop.Converters"
             x:Class="Desktop.Controls.Panels.LayersPanel"
             x:CompileBindings="False">

  <DockPanel>

    <!-- ═══ HEADER with action buttons ═══ -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource Brush.Bg2}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="8,5">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Text="LAYERS &amp; OBJECTS"
                   Classes="section"
                   Margin="2,0"
                   VerticalAlignment="Center"/>
        <!-- Add layer -->
        <Button Grid.Column="1"
                Theme="{StaticResource Btn.Icon}"
                ToolTip.Tip="Add layer"
                Click="OnAddLayer">
          <PathIcon Data="{StaticResource Icon.Plus}" Width="15" Height="15"/>
        </Button>
        <!-- Group selected -->
        <Button Grid.Column="2"
                Theme="{StaticResource Btn.Icon}"
                ToolTip.Tip="Group selected parts"
                Click="OnGroupSelected">
          <PathIcon Data="{StaticResource Icon.AddBox}" Width="15" Height="15"/>
        </Button>
        <!-- Move up / down in layer order -->
        <Button Grid.Column="3"
                Theme="{StaticResource Btn.Icon}"
                ToolTip.Tip="Move layer up"
                Click="OnMoveLayerUp">
          <PathIcon Data="{StaticResource Icon.ArrowUp}" Width="13" Height="13"/>
        </Button>
        <Button Grid.Column="4"
                Theme="{StaticResource Btn.Icon}"
                ToolTip.Tip="Move layer down"
                Click="OnMoveLayerDown">
          <PathIcon Data="{StaticResource Icon.ArrowDown}" Width="13" Height="13"/>
        </Button>
      </Grid>
    </Border>

    <!-- ═══ NO-GO ZONES (docked bottom so tree gets remaining space) ═══ -->
    <Border DockPanel.Dock="Bottom"
            Background="{StaticResource Brush.Bg1}">
      <StackPanel>
        <Border Background="{StaticResource Brush.Bg2}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,1"
                Padding="10,5">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="NO-GO ZONES"
                       Classes="section"
                       Margin="0"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Theme="{StaticResource Btn.Icon}"
                    ToolTip.Tip="Add no-go zone"
                    Click="OnAddNoGoZone">
              <PathIcon Data="{StaticResource Icon.Plus}" Width="15" Height="15"/>
            </Button>
          </Grid>
        </Border>
        <ItemsControl x:Name="NoGoZonesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="0,0,0,1"
                      Padding="8,4"
                      Tag="{Binding}">
                <Grid ColumnDefinitions="*,50,50,22" RowDefinitions="Auto,Auto" Margin="0,2">
                  <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding Label, Mode=TwoWay}"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="2,0"
                           FontSize="{StaticResource Font.Sm}"
                           Foreground="{StaticResource Brush.Text}"
                           LostFocus="OnZoneNameCommit"
                           KeyDown="OnZoneKeyDown"
                           Tag="{Binding}"/>
                  <Button Grid.Row="0" Grid.Column="3"
                          Theme="{StaticResource Btn.Icon}"
                          Width="22" Height="22"
                          Foreground="{StaticResource Brush.Danger}"
                          ToolTip.Tip="Delete zone"
                          Click="OnDeleteNoGoZone"
                          Tag="{Binding}">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="11" Height="11"/>
                  </Button>
                  <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                        ColumnDefinitions="20,*,8,20,*,8,20,*,8,20,*"
                        Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="X" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding X, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                    <TextBlock Grid.Column="3" Text="Y" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Text="{Binding Y, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                    <TextBlock Grid.Column="6" Text="W" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="7" Text="{Binding Width, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                    <TextBlock Grid.Column="9" Text="H" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="10" Text="{Binding Height, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ZonesEmptyHint"
                   Text="No zones defined"
                   Classes="muted"
                   HorizontalAlignment="Center"
                   Margin="0,6"/>
      </StackPanel>
    </Border>

    <!-- ═══ TREE (layers → groups → parts) ═══ -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="LayerTree">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!--
              One Border per tree node. The left Margin is set to IndentMargin
              via the IndentMargin property (Depth * 18 px per level).
              Background turns accent-tinted when the part is selected on canvas.
            -->
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Background="{Binding IsSelected, Converter={x:Static conv:BoolToActiveLayerBgConverter.Instance}}"
                    PointerPressed="OnTreeRowPressed"
                    Tag="{Binding}">
              <Border.ContextMenu>
                <ContextMenu Tag="{Binding}">
                  <!-- Part-only operations (hidden on Layer, Group, Object rows) -->
                  <MenuItem Header="Duplicate"
                            IsVisible="{Binding IsPartKind}"
                            Click="OnCtxDuplicate"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Duplicate}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Delete"
                            IsVisible="{Binding IsPartKind}"
                            Click="OnCtxDelete"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding IsPartKind}"/>
                  <MenuItem Header="Move to Layer…"
                            IsVisible="{Binding IsPartKind}"
                            Click="OnCtxMoveToLayer"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Layers}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding IsPartKind}"/>
                  <!-- Group operations (shown for parts and groups) -->
                  <MenuItem Header="Group"
                            IsVisible="{Binding IsPartKind}"
                            Click="OnCtxGroup"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.AddBox}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Pop out of Group"
                            IsVisible="{Binding IsPartKind}"
                            Click="OnCtxPopFromGroup"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.ArrowLeft}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Ungroup"
                            IsVisible="{Binding IsGroupKind}"
                            Click="OnUngroup"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Ungroup"
                            IsVisible="{Binding IsInGroup}"
                            Click="OnCtxUngroupFromPart"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Close}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <Separator IsVisible="{Binding IsPartKind}"/>
                  <!-- Visibility / Lock (all node types) -->
                  <MenuItem Header="Hide Selected Objects"
                            Click="OnToggleVisible"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.EyeOff}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Lock Selected Objects"
                            IsVisible="{Binding IsLayerKind}"
                            Click="OnToggleLock"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Lock}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <!-- Layer operations -->
                  <Separator IsVisible="{Binding IsLayerKind}"/>
                  <MenuItem Header="Add Layer"
                            IsVisible="{Binding IsLayerKind}"
                            Click="OnAddLayer">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Plus}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Delete Layer"
                            IsVisible="{Binding IsLayerKind}"
                            Click="OnDeleteLayer"
                            Tag="{Binding}">
                    <MenuItem.Icon>
                      <PathIcon Data="{StaticResource Icon.Trash}" Width="14" Height="14"/>
                    </MenuItem.Icon>
                  </MenuItem>
                </ContextMenu>
              </Border.ContextMenu>

              <!-- Single-child Panel holds all 3 conditional row layouts -->
              <Panel>

              <!-- ── LAYER ROW ── -->
              <Grid IsVisible="{Binding IsLayerKind}"
                    ColumnDefinitions="22,12,*,72,22,22,22,22"
                    Margin="0,0,0,0"
                    Height="28">

                <!-- expand toggle -->
                <Button Grid.Column="0"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        FontSize="9"
                        Content="{Binding ExpandIcon}"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Click="OnExpandToggle"
                        Tag="{Binding}"/>

                <!-- colour swatch -->
                <Button Grid.Column="1"
                        Width="12" Height="12"
                        Padding="0"
                        Background="{Binding LayerColor}"
                        CornerRadius="6"
                        ToolTip.Tip="Change layer color"
                        Click="OnChangeColor"
                        Tag="{Binding}"/>

                <!-- layer name (inline edit) -->
                <TextBox Grid.Column="2"
                         Text="{Binding DisplayName, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4,0"
                         VerticalAlignment="Center"
                         FontSize="{StaticResource Font.Sm}"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource Brush.Text}"
                         LostFocus="OnLayerNameCommit"
                         KeyDown="OnLayerNameKeyDown"
                         Tag="{Binding}"/>

                <!-- operation mode badge -->
                <Button Grid.Column="3"
                        Height="18"
                        Margin="2,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="{StaticResource Font.Xs}"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Background="{StaticResource Brush.Bg3}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Sm}"
                        Padding="4,0"
                        Content="{Binding Layer.OperationMode}"
                        Click="OnCycleOperationMode"
                        Tag="{Binding}"
                        ToolTip.Tip="Click to cycle: Cut → Score → Engrave"/>

                <!-- settings flyout -->
                <Button Grid.Column="4"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Layer settings"
                        Tag="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Sliders}" Width="12" Height="12"/>
                  <Button.Flyout>
                    <Flyout Placement="Left">
                      <Border Background="{StaticResource Brush.Bg2}"
                              BorderBrush="{StaticResource Brush.Border}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="12,10">
                        <StackPanel Spacing="8" Width="180">
                          <TextBlock Text="{Binding DisplayName}"
                                     FontSize="{StaticResource Font.Sm}"
                                     Foreground="{StaticResource Brush.TextMuted}"/>
                          <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,8,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Feed (mm/min)"
                                       FontSize="{StaticResource Font.Xs}" Classes="muted"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Height="24" FontSize="{StaticResource Font.Xs}"
                                     PlaceholderText="global"
                                     Text="{Binding Layer.FeedRateMmMinOverride}"
                                     LostFocus="OnFeedOverrideCommit"
                                     KeyDown="OnOverrideKeyDown"
                                     Tag="{Binding}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Power %"
                                       FontSize="{StaticResource Font.Xs}" Classes="muted"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Height="24" FontSize="{StaticResource Font.Xs}"
                                     PlaceholderText="global"
                                     Text="{Binding Layer.LaserPowerPercentOverride}"
                                     LostFocus="OnPowerOverrideCommit"
                                     KeyDown="OnOverrideKeyDown"
                                     Tag="{Binding}"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <!-- visibility -->
                <Button Grid.Column="5"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Toggle visibility"
                        Click="OnToggleVisible"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Visible, Converter={x:Static conv:VisibilityIconConverter.Instance}}"
                            Width="14" Height="14"/>
                </Button>

                <!-- lock -->
                <Button Grid.Column="6"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Lock / unlock layer"
                        Click="OnToggleLock"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Layer.Locked, Converter={x:Static conv:LockIconConverter.Instance}}"
                            Width="12" Height="12"/>
                </Button>

                <!-- delete -->
                <Button Grid.Column="7"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        Foreground="{StaticResource Brush.Danger}"
                        ToolTip.Tip="Delete layer"
                        Click="OnDeleteLayer"
                        Tag="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Close}" Width="11" Height="11"/>
                </Button>
              </Grid>

              <!-- ── GROUP ROW ── -->
              <Grid IsVisible="{Binding IsGroupKind}"
                    ColumnDefinitions="*,22,22"
                    Margin="{Binding IndentMargin}"
                    Height="26">

                <!-- expand + folder icon + editable name -->
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Theme="{StaticResource Btn.Icon}"
                          Width="20" Height="20"
                          FontSize="9"
                          Content="{Binding ExpandIcon}"
                          Foreground="{StaticResource Brush.TextMuted}"
                          Click="OnExpandToggle"
                          Tag="{Binding}"/>
                  <!-- folder icon (unicode) -->
                  <TextBlock Text="📁" FontSize="12" VerticalAlignment="Center" Margin="1,0"/>
                  <TextBox Text="{Binding GroupName, Mode=TwoWay}"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="2,0"
                           MinWidth="60"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Font.Sm}"
                           Foreground="{StaticResource Brush.Text}"
                           LostFocus="OnGroupNameCommit"
                           KeyDown="OnGroupNameKeyDown"
                           Tag="{Binding}"/>
                </StackPanel>

                <!-- visibility -->
                <Button Grid.Column="1"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Toggle group visibility"
                        Click="OnToggleVisible"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Visible, Converter={x:Static conv:VisibilityIconConverter.Instance}}"
                            Width="14" Height="14"/>
                </Button>

                <!-- ungroup -->
                <Button Grid.Column="2"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        Foreground="{StaticResource Brush.Danger}"
                        ToolTip.Tip="Ungroup"
                        Click="OnUngroup"
                        Tag="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Close}" Width="11" Height="11"/>
                </Button>
              </Grid>

              <!-- ── PART ROW ── -->
              <Grid IsVisible="{Binding IsPartKind}"
                    ColumnDefinitions="20,Auto,*,22"
                    Margin="{Binding IndentMargin}"
                    Height="24">

                <!-- expand toggle (▼/▶) — collapses/expands path objects underneath -->
                <Button Grid.Column="0"
                        Theme="{StaticResource Btn.Icon}"
                        Width="20" Height="20"
                        FontSize="9"
                        Content="{Binding ExpandIcon}"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Click="OnExpandToggle"
                        Tag="{Binding}"/>

                <!-- chain-link icon: visible when part moves with siblings -->
                <PathIcon Grid.Column="1"
                          Data="{StaticResource Icon.Link}"
                          Width="11" Height="11"
                          Foreground="{StaticResource Brush.TextMuted}"
                          IsVisible="{Binding ShowLinkIcon}"
                          ToolTip.Tip="Linked — moves with siblings. Right-click → Ungroup to detach."
                          Margin="2,0,3,0"
                          VerticalAlignment="Center"/>

                <!-- part name -->
                <TextBlock Grid.Column="2"
                           Text="{Binding PartDisplayName}"
                           VerticalAlignment="Center"
                           FontSize="{StaticResource Font.Sm}"
                           Foreground="{StaticResource Brush.Text}"
                           TextTrimming="CharacterEllipsis"
                           Margin="4,0"
                           Cursor="Hand"/>

                <!-- visibility -->
                <Button Grid.Column="3"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Toggle visibility"
                        Click="OnToggleVisible"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Visible, Converter={x:Static conv:VisibilityIconConverter.Instance}}"
                            Width="14" Height="14"/>
                </Button>
              </Grid>

              <!-- ── OBJECT ROW (individual PathGeometry — Inkscape-style leaf node) ── -->
              <Grid IsVisible="{Binding IsObjectKind}"
                    ColumnDefinitions="18,*,22"
                    Margin="{Binding IndentMargin}"
                    Height="21">

                <!-- path icon -->
                <PathIcon Grid.Column="0"
                          Data="{StaticResource Icon.PathNode}"
                          Width="11" Height="11"
                          Foreground="{StaticResource Brush.TextMuted}"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center"/>

                <!-- object name — inline editable (click to rename) -->
                <TextBox Grid.Column="1"
                         Text="{Binding DisplayName, Mode=OneWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="3,0"
                         VerticalAlignment="Center"
                         FontSize="{StaticResource Font.Xs}"
                         Foreground="{StaticResource Brush.TextMuted}"
                         IsReadOnly="True"
                         LostFocus="OnObjectNameCommit"
                         KeyDown="OnObjectNameKeyDown"
                         GotFocus="OnObjectNameFocus"
                         Tag="{Binding}"/>

                <!-- visibility -->
                <Button Grid.Column="2"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Toggle path visibility"
                        Click="OnToggleVisible"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Visible, Converter={x:Static conv:VisibilityIconConverter.Instance}}"
                            Width="13" Height="13"/>
                </Button>
              </Grid>

              </Panel><!-- /single-child Panel -->
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>
</UserControl>
