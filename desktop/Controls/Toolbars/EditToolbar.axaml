<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Desktop.Converters"
             x:Class="Desktop.Controls.Toolbars.EditToolbar"
             x:CompileBindings="False"
             IsVisible="{Binding SelectedPart, Converter={x:Static conv:NotNullConverter.Instance}}">

  <Border Background="{StaticResource Brush.Bg2}"
          BorderBrush="{StaticResource Brush.Border}"
          BorderThickness="0,1,0,0"
          Padding="8,4">
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Horizontal" Spacing="4">

        <!-- X / Y coordinates -->
        <TextBlock Text="X" Classes="muted" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <TextBox x:Name="TbX" Width="60" LostFocus="OnTransformChanged"/>
        <TextBlock Text="Y" Classes="muted" VerticalAlignment="Center" Margin="8,0,2,0"/>
        <TextBox x:Name="TbY" Width="60" LostFocus="OnTransformChanged"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Width / Height -->
        <TextBlock Text="W" Classes="muted" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <TextBox x:Name="TbW" Width="60" LostFocus="OnSizeChanged"/>
        <Button Theme="{StaticResource Btn.Icon}" Width="24" Height="24"
                x:Name="BtnLock" Click="OnToggleLock" ToolTip.Tip="Lock aspect ratio">
          <PathIcon Data="{StaticResource Icon.Lock}" Width="13" Height="13"/>
        </Button>
        <TextBlock Text="H" Classes="muted" VerticalAlignment="Center" Margin="2,0,2,0"/>
        <TextBox x:Name="TbH" Width="60" LostFocus="OnSizeChanged"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Rotation -->
        <TextBlock Text="°" Classes="muted" VerticalAlignment="Center"/>
        <TextBox x:Name="TbRot" Width="50" LostFocus="OnRotChanged"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Mirror -->
        <Button Theme="{StaticResource Btn.Icon}" Click="OnMirrorH" ToolTip.Tip="Mirror horizontal">
          <PathIcon Data="{StaticResource Icon.MirrorH}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnMirrorV" ToolTip.Tip="Mirror vertical">
          <PathIcon Data="{StaticResource Icon.MirrorV}" Width="16" Height="16"/>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Align -->
        <Button Theme="{StaticResource Btn.Icon}" Click="OnAlignLeft"   ToolTip.Tip="Align left">
          <PathIcon Data="{StaticResource Icon.AlignLeft}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnAlignRight"  ToolTip.Tip="Align right">
          <PathIcon Data="{StaticResource Icon.AlignRight}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnAlignTop"    ToolTip.Tip="Align top">
          <PathIcon Data="{StaticResource Icon.AlignTop}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnAlignBottom" ToolTip.Tip="Align bottom">
          <PathIcon Data="{StaticResource Icon.AlignBottom}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnCenter"      ToolTip.Tip="Center on sheet">
          <PathIcon Data="{StaticResource Icon.Center}" Width="16" Height="16"/>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Rotate quick -->
        <Button Theme="{StaticResource Btn.Icon}" Click="OnRotate90CW" ToolTip.Tip="Rotate 90° CW">
          <PathIcon Data="{StaticResource Icon.RotateCW}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnRotate90CCW" ToolTip.Tip="Rotate 90° CCW">
          <PathIcon Data="{StaticResource Icon.RotateCCW}" Width="16" Height="16"/>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Stacking -->
        <Button Theme="{StaticResource Btn.Icon}" Click="OnBringToFront" ToolTip.Tip="Bring to front">
          <PathIcon Data="{StaticResource Icon.Front}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnSendToBack" ToolTip.Tip="Send to back">
          <PathIcon Data="{StaticResource Icon.Back}" Width="16" Height="16"/>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Layer -->
        <TextBlock Text="Layer" Classes="muted" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <ComboBox x:Name="CbLayer" Width="100" SelectionChanged="OnLayerChanged"
                  HorizontalAlignment="Stretch"/>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Contour offset -->
        <TextBlock Text="Offset" Classes="muted" VerticalAlignment="Center" Margin="4,0,2,0"/>
        <TextBox x:Name="TbOffset" Width="50" Watermark="mm" ToolTip.Tip="Offset contour (±mm)"/>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnApplyOffset" ToolTip.Tip="Apply offset">
          <PathIcon Data="{StaticResource Icon.Check}" Width="16" Height="16"/>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Array -->
        <Button x:Name="BtnArray" Theme="{StaticResource Btn.Icon}" ToolTip.Tip="Create array">
          <PathIcon Data="{StaticResource Icon.Array}" Width="16" Height="16"/>
        </Button>

        <Separator Theme="{StaticResource Sep.Vertical}"/>

        <!-- Duplicate / Delete -->
        <Button Theme="{StaticResource Btn.Icon}" Click="OnDuplicate" ToolTip.Tip="Duplicate">
          <PathIcon Data="{StaticResource Icon.Duplicate}" Width="16" Height="16"/>
        </Button>
        <Button Theme="{StaticResource Btn.Icon}" Click="OnDelete"
                Foreground="{StaticResource Brush.Danger}" ToolTip.Tip="Delete">
          <PathIcon Data="{StaticResource Icon.Trash}" Width="15" Height="15"/>
        </Button>

      </StackPanel>
    </ScrollViewer>
  </Border>

</UserControl>
