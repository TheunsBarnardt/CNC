<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Desktop.Views.ShapeDialog"
        Title="Create Shape"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Spacing="16" Margin="20">

    <TextBlock Text="Rectangle" FontSize="18" FontWeight="SemiBold"/>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="8">

      <!-- Width -->
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Width (mm):" VerticalAlignment="Center"/>
      <TextBox x:Name="TbWidth" Grid.Row="0" Grid.Column="1" Text="100"/>

      <!-- Height -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Height (mm):" VerticalAlignment="Center"/>
      <TextBox x:Name="TbHeight" Grid.Row="1" Grid.Column="1" Text="60"/>

      <!-- Corner Radius (for rectangle only) -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Corner Radius (mm):" VerticalAlignment="Center"/>
      <TextBox x:Name="TbRadius" Grid.Row="2" Grid.Column="1" Text="0"/>

    </Grid>

    <!-- Buttons -->
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="BtnCancel" Content="Cancel" Padding="12,8"/>
      <Button x:Name="BtnCreate" Content="Create" Padding="12,8" Background="#3b82f6" Foreground="White"/>
    </StackPanel>

  </StackPanel>

</Window>
