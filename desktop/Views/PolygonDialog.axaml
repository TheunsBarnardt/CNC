<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Desktop.Views.PolygonDialog"
        Title="Create Polygon"
        Width="350" Height="250"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

  <StackPanel Spacing="16" Margin="20">

    <TextBlock Text="Polygon" FontSize="18" FontWeight="SemiBold"/>

    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">

      <TextBlock Grid.Row="0" Grid.Column="0" Text="Sides:" VerticalAlignment="Center"/>
      <TextBox x:Name="TbSides" Grid.Row="0" Grid.Column="1" Text="6"/>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="Radius (mm):" VerticalAlignment="Center"/>
      <TextBox x:Name="TbRadius" Grid.Row="1" Grid.Column="1" Text="50"/>

    </Grid>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button x:Name="BtnCancel" Content="Cancel" Padding="12,8"/>
      <Button x:Name="BtnCreate" Content="Create" Padding="12,8" Background="#3b82f6" Foreground="White"/>
    </StackPanel>

  </StackPanel>

</Window>
