<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Desktop.Converters"
             x:Class="Desktop.Controls.Panels.LayersPanel"
             x:CompileBindings="False">

  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource Brush.Bg2}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="LAYERS"
                   Classes="section"
                   Margin="0"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Theme="{StaticResource Btn.Icon}"
                ToolTip.Tip="Add layer"
                Click="OnAddLayer">
          <PathIcon Data="{StaticResource Icon.Plus}" Width="15" Height="15"/>
        </Button>
      </Grid>
    </Border>

    <!-- empty hint -->
    <TextBlock x:Name="LayersEmptyHint"
               DockPanel.Dock="Bottom"
               Text="No layers"
               Classes="muted"
               HorizontalAlignment="Center"
               Margin="0,12"/>

    <!-- no-go zones section -->
    <Border DockPanel.Dock="Bottom"
            Background="{StaticResource Brush.Bg1}">
      <StackPanel>
        <Border Background="{StaticResource Brush.Bg2}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,1"
                Padding="10,5">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="NO-GO ZONES"
                       Classes="section"
                       Margin="0"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="1"
                    Theme="{StaticResource Btn.Icon}"
                    ToolTip.Tip="Add no-go zone"
                    Click="OnAddNoGoZone">
              <PathIcon Data="{StaticResource Icon.Plus}" Width="15" Height="15"/>
            </Button>
          </Grid>
        </Border>
        <ItemsControl x:Name="NoGoZonesList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="0,0,0,1"
                      Padding="8,4"
                      Tag="{Binding}">
                <Grid ColumnDefinitions="*,50,50,22" RowDefinitions="Auto,Auto" Margin="0,2">
                  <TextBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="{Binding Label, Mode=TwoWay}"
                           Background="Transparent"
                           BorderThickness="0"
                           Padding="2,0"
                           FontSize="{StaticResource Font.Sm}"
                           Foreground="{StaticResource Brush.Text}"
                           LostFocus="OnZoneNameCommit"
                           KeyDown="OnZoneKeyDown"
                           Tag="{Binding}"/>
                  <Button Grid.Row="0" Grid.Column="3"
                          Theme="{StaticResource Btn.Icon}"
                          Width="22" Height="22"
                          Foreground="{StaticResource Brush.Danger}"
                          ToolTip.Tip="Delete zone"
                          Click="OnDeleteNoGoZone"
                          Tag="{Binding}">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="11" Height="11"/>
                  </Button>
                  <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                        ColumnDefinitions="20,*,8,20,*,8,20,*,8,20,*"
                        Margin="0,2,0,0">
                    <TextBlock Grid.Column="0" Text="X" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding X, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                    <TextBlock Grid.Column="3" Text="Y" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="4" Text="{Binding Y, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                    <TextBlock Grid.Column="6" Text="W" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="7" Text="{Binding Width, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                    <TextBlock Grid.Column="9" Text="H" Classes="muted" FontSize="{StaticResource Font.Xs}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="10" Text="{Binding Height, Mode=TwoWay}"
                             Height="20" FontSize="{StaticResource Font.Xs}"
                             LostFocus="OnZoneDimsCommit" KeyDown="OnZoneKeyDown" Tag="{Binding}"/>
                  </Grid>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ZonesEmptyHint"
                   Text="No zones defined"
                   Classes="muted"
                   HorizontalAlignment="Center"
                   Margin="0,6"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="LayersList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    PointerPressed="OnLayerRowPressed"
                    Tag="{Binding}">
              <!-- active-layer highlight: accent left strip + subtle tint -->
              <Border Padding="8,4"
                      Background="{Binding IsActive, Converter={x:Static conv:BoolToActiveLayerBgConverter.Instance}}"
                      BorderBrush="{Binding Color}"
                      BorderThickness="{Binding IsActive, Converter={x:Static conv:BoolToActiveLayerBorderConverter.Instance}}">

              <!-- single compact row: ● Name  [Cut▾] [⚙] [👁] [🔒] [✕] -->
              <Grid ColumnDefinitions="18,*,72,22,22,22,22"
                    VerticalAlignment="Center">

                <!-- colour swatch (clickable to pick color) -->
                <Button Grid.Column="0"
                        Width="12" Height="12"
                        Padding="0"
                        Margin="2,0,6,0"
                        Background="{Binding Color}"
                        CornerRadius="6"
                        ToolTip.Tip="Change layer color"
                        Click="OnChangeColor"
                        Tag="{Binding}"/>

                <!-- layer name (inline edit) -->
                <TextBox Grid.Column="1"
                         Text="{Binding Name, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="2,0"
                         VerticalAlignment="Center"
                         FontSize="{StaticResource Font.Md}"
                         Foreground="{StaticResource Brush.Text}"
                         LostFocus="OnNameCommit"
                         KeyDown="OnNameKeyDown"
                         Tag="{Binding}"/>

                <!-- operation mode — click cycles Cut→Score→Engrave -->
                <Button Grid.Column="2"
                        Height="18"
                        Margin="2,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        FontSize="{StaticResource Font.Xs}"
                        Foreground="{StaticResource Brush.TextMuted}"
                        Background="{StaticResource Brush.Bg3}"
                        BorderBrush="{StaticResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Sm}"
                        Padding="4,0"
                        Content="{Binding OperationMode}"
                        Click="OnCycleOperationMode"
                        Tag="{Binding}"
                        ToolTip.Tip="Click to toggle Cut / Score / Engrave"/>

                <!-- settings gear — opens feed/power flyout -->
                <Button Grid.Column="3"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Layer settings (feed rate, power)"
                        Tag="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Sliders}" Width="12" Height="12"/>
                  <Button.Flyout>
                    <Flyout Placement="Left">
                      <Border Background="{StaticResource Brush.Bg2}"
                              BorderBrush="{StaticResource Brush.Border}"
                              BorderThickness="1"
                              CornerRadius="6"
                              Padding="12,10">
                        <StackPanel Spacing="8" Width="180">
                          <TextBlock Text="{Binding Name}"
                                     FontSize="{StaticResource Font.Sm}"
                                     Foreground="{StaticResource Brush.TextMuted}"/>
                          <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,8,Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Feed (mm/min)"
                                       FontSize="{StaticResource Font.Xs}" Classes="muted"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Height="24" FontSize="{StaticResource Font.Xs}"
                                     PlaceholderText="global"
                                     Text="{Binding FeedRateMmMinOverride}"
                                     ToolTip.Tip="Feed-rate override mm/min (blank = global)"
                                     LostFocus="OnFeedOverrideCommit"
                                     KeyDown="OnOverrideKeyDown"
                                     Tag="{Binding}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Power %"
                                       FontSize="{StaticResource Font.Xs}" Classes="muted"
                                       VerticalAlignment="Center"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Height="24" FontSize="{StaticResource Font.Xs}"
                                     PlaceholderText="global"
                                     Text="{Binding LaserPowerPercentOverride}"
                                     ToolTip.Tip="Laser power override % (blank = global)"
                                     LostFocus="OnPowerOverrideCommit"
                                     KeyDown="OnOverrideKeyDown"
                                     Tag="{Binding}"/>
                          </Grid>
                        </StackPanel>
                      </Border>
                    </Flyout>
                  </Button.Flyout>
                </Button>

                <!-- visibility -->
                <Button Grid.Column="4"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Toggle visibility"
                        Click="OnToggleVisible"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Visible, Converter={x:Static conv:VisibilityIconConverter.Instance}}"
                            Width="14" Height="14"/>
                </Button>

                <!-- lock -->
                <Button Grid.Column="5"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Lock / unlock layer"
                        Click="OnToggleLock"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Locked, Converter={x:Static conv:LockIconConverter.Instance}}"
                            Width="12" Height="12"/>
                </Button>

                <!-- delete -->
                <Button Grid.Column="6"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        Foreground="{StaticResource Brush.Danger}"
                        ToolTip.Tip="Delete layer"
                        Click="OnDeleteLayer"
                        Tag="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Close}" Width="11" Height="11"/>
                </Button>
              </Grid>

              </Border><!-- /inner active-highlight Border -->
            </Border><!-- /outer row Border -->
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>

</UserControl>
