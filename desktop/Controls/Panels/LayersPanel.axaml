<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Desktop.Converters"
             x:Class="Desktop.Controls.Panels.LayersPanel"
             x:CompileBindings="False">

  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource Brush.Bg2}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="LAYERS"
                   Classes="section"
                   Margin="0"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1"
                Theme="{StaticResource Btn.Icon}"
                ToolTip.Tip="Add layer"
                Click="OnAddLayer">
          <PathIcon Data="{StaticResource Icon.Plus}" Width="15" Height="15"/>
        </Button>
      </Grid>
    </Border>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Layers}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Background="Transparent"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <!-- colour swatch (click to change color) -->
                <Button Grid.Column="0"
                        Width="14" Height="14"
                        Padding="0"
                        Margin="0,0,6,0"
                        Background="{Binding Color}"
                        CornerRadius="{StaticResource Radius.Sm}"
                        ToolTip.Tip="Change layer color"
                        Click="OnChangeColor"
                        Tag="{Binding}"/>

                <!-- layer name -->
                <TextBox Grid.Column="1"
                         Text="{Binding Name}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         VerticalAlignment="Center"
                         FontSize="{StaticResource Font.Md}"
                         Foreground="{StaticResource Brush.Text}"/>

                <!-- operation mode dropdown -->
                <ComboBox Grid.Column="2"
                          SelectedItem="{Binding OperationMode}"
                          Width="90"
                          ToolTip.Tip="Cut / Score / Engrave"
                          SelectionChanged="OnOperationModeChanged"
                          Tag="{Binding}">
                  <ComboBoxItem>Cut</ComboBoxItem>
                  <ComboBoxItem>Score</ComboBoxItem>
                  <ComboBoxItem>Engrave</ComboBoxItem>
                </ComboBox>

                <!-- visibility -->
                <Button Grid.Column="3"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        ToolTip.Tip="Toggle visibility"
                        Click="OnToggleVisible"
                        Tag="{Binding}">
                  <PathIcon Data="{Binding Visible, Converter={x:Static conv:VisibilityIconConverter.Instance}}"
                            Width="15" Height="15"/>
                </Button>

                <!-- delete -->
                <Button Grid.Column="4"
                        Theme="{StaticResource Btn.Icon}"
                        Width="22" Height="22"
                        Foreground="{StaticResource Brush.Danger}"
                        ToolTip.Tip="Delete layer"
                        Click="OnDeleteLayer"
                        Tag="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Close}" Width="13" Height="13"/>
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>

</UserControl>
