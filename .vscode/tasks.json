{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-desktop",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/desktop/desktop.csproj"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-backend",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/backend/backend.csproj"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run-desktop",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "${workspaceFolder}/desktop/desktop.csproj"],
      "cwd": "${workspaceFolder}/desktop"
    },
    {
      "label": "rebuild-desktop",
      "type": "shell",
      "command": "dotnet clean && dotnet build",
      "args": ["${workspaceFolder}/desktop/desktop.csproj"],
      "cwd": "${workspaceFolder}/desktop",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test"],
      "cwd": "${workspaceFolder}",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "clean",
      "type": "process",
      "command": "dotnet",
      "args": ["clean"],
      "cwd": "${workspaceFolder}",
      "problemMatcher": "$msCompile"
    }
  ]
}
