<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Desktop.Converters"
             x:Class="Desktop.Controls.Panels.DevicePanel"
             x:CompileBindings="False">

  <ScrollViewer>
    <StackPanel Spacing="0" Margin="0,0,0,12">

      <!-- ── Connection ──────────────────────────────────────── -->
      <Expander Header="Connection"
                Theme="{StaticResource Card.Expander}"
                IsExpanded="True"
                Margin="8,8,8,0">
        <StackPanel Spacing="6">
          <!-- port + baud row -->
          <Grid ColumnDefinitions="*,90,Auto">
            <ComboBox Grid.Column="0" x:Name="CbPort"
                      HorizontalAlignment="Stretch"
                      DropDownOpened="OnPortDropDown"/>
            <ComboBox Grid.Column="1" x:Name="CbBaud"
                      Margin="6,0,0,0">
              <ComboBoxItem Content="9600"   Tag="9600"/>
              <ComboBoxItem Content="115200" Tag="115200" IsSelected="True"/>
              <ComboBoxItem Content="230400" Tag="230400"/>
            </ComboBox>
            <Button Grid.Column="2"
                    x:Name="BtnConnect"
                    Content="{Binding Machine.IsConnected, Converter={x:Static conv:ConnectLabelConverter.Instance}}"
                    Theme="{StaticResource Btn.Primary}"
                    Margin="6,0,0,0"
                    Padding="10,4"
                    Click="OnConnectToggle"/>
          </Grid>

          <!-- status bar -->
          <Border Background="{StaticResource Brush.Bg3}"
                  CornerRadius="{StaticResource Radius.Sm}"
                  Padding="8,4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Ellipse Width="8" Height="8"
                       Fill="{Binding Machine.IsConnected, Converter={x:Static conv:ConnectedColorConverter.Instance}}"/>
              <TextBlock Text="{Binding Machine.MachineState}"
                         Foreground="{StaticResource Brush.Text}"
                         FontSize="{StaticResource Font.Md}"
                         VerticalAlignment="Center"/>
              <TextBlock Text="{Binding Machine.ErrorText}"
                         Foreground="{StaticResource Brush.Danger}"
                         FontSize="{StaticResource Font.Sm}"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         IsVisible="{Binding Machine.ErrorText.Length}"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Expander>

      <!-- ── DRO ────────────────────────────────────────────── -->
      <Expander Header="Position (DRO)"
                Theme="{StaticResource Card.Expander}"
                IsExpanded="True"
                IsVisible="{Binding Machine.IsConnected}"
                Margin="8,6,8,0">
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto">
          <TextBlock Grid.Column="0" Text="X" Foreground="{StaticResource Brush.Info}"
                     FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <TextBlock Grid.Column="1" Text="{Binding Machine.X, StringFormat=F3}"
                     Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="2" Text="Y" Foreground="{StaticResource Brush.Success}"
                     FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,4,0"/>
          <TextBlock Grid.Column="3" Text="{Binding Machine.Y, StringFormat=F3}"
                     Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="Z" Foreground="{StaticResource Brush.Warning}"
                     FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,4,0"/>
          <TextBlock Grid.Column="5" Text="{Binding Machine.Z, StringFormat=F3}"
                     Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center"/>
        </Grid>
      </Expander>

      <!-- ── Jog ────────────────────────────────────────────── -->
      <Expander Header="Jog"
                Theme="{StaticResource Card.Expander}"
                IsExpanded="True"
                IsVisible="{Binding Machine.IsConnected}"
                Margin="8,6,8,0">
        <StackPanel Spacing="6">
          <!-- step size -->
          <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Text="Step (mm)" Classes="muted" VerticalAlignment="Center"/>
            <ComboBox x:Name="CbJogStep" SelectedIndex="2" MinWidth="80">
              <ComboBoxItem Content="0.01" Tag="0.01"/>
              <ComboBoxItem Content="0.1"  Tag="0.1"/>
              <ComboBoxItem Content="1"    Tag="1"/>
              <ComboBoxItem Content="10"   Tag="10"/>
              <ComboBoxItem Content="100"  Tag="100"/>
            </ComboBox>
            <TextBlock Text="Feed" Classes="muted" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <ComboBox x:Name="CbJogFeed" SelectedIndex="1" MinWidth="80">
              <ComboBoxItem Content="100"  Tag="100"/>
              <ComboBoxItem Content="1000" Tag="1000"/>
              <ComboBoxItem Content="3000" Tag="3000"/>
            </ComboBox>
          </StackPanel>

          <!-- X/Y jog grid -->
          <Grid ColumnDefinitions="36,36,36" RowDefinitions="36,36,36" HorizontalAlignment="Center">
            <Button Grid.Row="0" Grid.Column="1" Theme="{StaticResource Btn.Ghost}"
                    Click="OnJog" Tag="Y+" ToolTip.Tip="Y+">
              <PathIcon Data="{StaticResource Icon.Front}" Width="16" Height="16"/>
            </Button>
            <Button Grid.Row="1" Grid.Column="0" Theme="{StaticResource Btn.Ghost}"
                    Click="OnJog" Tag="X-" ToolTip.Tip="X-">
              <PathIcon Data="M11,5 L4,12 L11,19 V14 H20 V10 H11 Z" Width="16" Height="16"/>
            </Button>
            <Button Grid.Row="1" Grid.Column="1" Theme="{StaticResource Btn.Icon}"
                    Click="OnHome" ToolTip.Tip="Home">
              <PathIcon Data="M2,12 L12,3 L22,12 V19 H18 V14 H6 V19 H2 Z" Width="18" Height="18"/>
            </Button>
            <Button Grid.Row="1" Grid.Column="2" Theme="{StaticResource Btn.Ghost}"
                    Click="OnJog" Tag="X+" ToolTip.Tip="X+">
              <PathIcon Data="M13,5 L20,12 L13,19 V14 H4 V10 H13 Z" Width="16" Height="16"/>
            </Button>
            <Button Grid.Row="2" Grid.Column="1" Theme="{StaticResource Btn.Ghost}"
                    Click="OnJog" Tag="Y-" ToolTip.Tip="Y-">
              <PathIcon Data="{StaticResource Icon.Back}" Width="16" Height="16"/>
            </Button>
          </Grid>

          <!-- Z jog -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
            <Button Theme="{StaticResource Btn.Ghost}" Click="OnJog" Tag="Z+" Width="48" ToolTip.Tip="Z Up">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="Z" VerticalAlignment="Center"/>
                <PathIcon Data="{StaticResource Icon.Front}" Width="12" Height="12"/>
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource Btn.Ghost}" Click="OnJog" Tag="Z-" Width="48" ToolTip.Tip="Z Down">
              <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                <TextBlock Text="Z" VerticalAlignment="Center"/>
                <PathIcon Data="{StaticResource Icon.Back}" Width="12" Height="12"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Home / Set Zero -->
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Home all" Theme="{StaticResource Btn.Ghost}"
                    Click="OnHome" Padding="8,4" HorizontalAlignment="Stretch"/>
            <Button Content="Set Zero" Theme="{StaticResource Btn.Ghost}"
                    Click="OnSetZero" Padding="8,4"/>
            <Button Content="Unlock" Theme="{StaticResource Btn.Ghost}"
                    Click="OnUnlock" Padding="8,4"/>
          </StackPanel>
        </StackPanel>
      </Expander>

      <!-- ── Run / Control ──────────────────────────────────── -->
      <Expander Header="Run"
                Theme="{StaticResource Card.Expander}"
                IsExpanded="True"
                IsVisible="{Binding Machine.IsConnected}"
                Margin="8,6,8,0">
        <StackPanel Spacing="8">
          <!-- run + feed hold + resume + stop -->
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="BtnRun"
                    Theme="{StaticResource Btn.Primary}"
                    Click="OnRun"
                    Padding="12,6"
                    IsEnabled="{Binding !Machine.IsJobRunning}"
                    HorizontalContentAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14"/>
                <TextBlock Text="Run" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource Btn.Ghost}"
                    Click="OnFeedHold"
                    Padding="12,6"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="Feed hold">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Pause}" Width="14" Height="14"/>
                <TextBlock Text="Hold" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource Btn.Ghost}"
                    Click="OnResume"
                    Padding="12,6"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="Resume">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Play}" Width="14" Height="14"/>
                <TextBlock Text="Resume" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button Theme="{StaticResource Btn.Danger}"
                    Click="OnStop"
                    Padding="12,6"
                    IsEnabled="{Binding Machine.IsJobRunning}"
                    HorizontalContentAlignment="Center"
                    ToolTip.Tip="Stop job">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource Icon.Stop}" Width="14" Height="14"/>
                <TextBlock Text="Stop" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- progress -->
          <ProgressBar Value="{Binding Machine.JobProgressPct}"
                       Minimum="0" Maximum="100"
                       Height="6"
                       Foreground="{StaticResource Brush.Accent}"
                       IsVisible="{Binding Machine.IsJobRunning}"/>

          <TextBlock Classes="muted"
                     IsVisible="{Binding Machine.IsJobRunning}">
            <Run Text="{Binding Machine.JobDone}"/>
            <Run Text=" / "/>
            <Run Text="{Binding Machine.JobTotal}"/>
            <Run Text=" lines"/>
          </TextBlock>

          <!-- E-STOP -->
          <Button Theme="{StaticResource Btn.Danger}"
                  Click="OnEStop"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  Height="44"
                  Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <Ellipse Width="12" Height="12" Fill="{StaticResource Brush.AccentFg}"/>
              <TextBlock Text="E-STOP" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Expander>

      <!-- ── Job log ────────────────────────────────────────── -->
      <Expander Header="Job log"
                Theme="{StaticResource Card.Expander}"
                IsVisible="{Binding Machine.IsConnected}"
                Margin="8,6,8,0">
        <DockPanel LastChildFill="True">
          <Button DockPanel.Dock="Top"
                  Content="Refresh"
                  Theme="{StaticResource Btn.Ghost}"
                  HorizontalAlignment="Left"
                  Padding="8,3"
                  Margin="0,0,0,4"
                  Click="OnRefreshLog"/>
          <ScrollViewer MaxHeight="200">
            <ItemsControl ItemsSource="{Binding Machine.JobLog}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Message}"
                             FontFamily="Courier New, Consolas, monospace"
                             FontSize="{StaticResource Font.Xs}"
                             Foreground="{Binding Event, Converter={x:Static conv:LogColorConverter.Instance}}"
                             Margin="0,1"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Expander>

    </StackPanel>
  </ScrollViewer>

</UserControl>
