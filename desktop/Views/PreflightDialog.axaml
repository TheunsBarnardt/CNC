<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Desktop.Views.PreflightDialog"
        Title="Pre-flight Check"
        Width="480" Height="400"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg1}">

  <Grid RowDefinitions="*,Auto" Margin="16">

    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="CheckList" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1"
                    Padding="8,7">
              <Grid ColumnDefinitions="20,*">
                <!-- status icon -->
                <TextBlock Grid.Column="0"
                           x:Name="StatusIcon"
                           FontSize="13"
                           VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock x:Name="ItemName"
                             FontSize="{StaticResource Font.Sm}"
                             Foreground="{StaticResource Brush.Text}"
                             FontWeight="Medium"/>
                  <TextBlock x:Name="ItemDetail"
                             FontSize="{StaticResource Font.Xs}"
                             Foreground="{StaticResource Brush.TextMuted}"
                             TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- footer -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
      <TextBlock Grid.Column="0"
                 x:Name="TbSummary"
                 VerticalAlignment="Center"
                 FontSize="{StaticResource Font.Sm}"
                 Foreground="{StaticResource Brush.TextMuted}"/>
      <Button Grid.Column="1"
              x:Name="BtnCancel"
              Content="Cancel"
              Margin="0,0,8,0"
              MinWidth="80"/>
      <Button Grid.Column="2"
              x:Name="BtnRun"
              Content="Run Job"
              Classes="accent"
              MinWidth="80"
              IsEnabled="False"/>
    </Grid>

  </Grid>
</Window>
