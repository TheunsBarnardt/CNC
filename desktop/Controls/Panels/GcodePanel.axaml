<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Desktop.Controls.Panels.GcodePanel"
             x:CompileBindings="False">

  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top"
            Background="{StaticResource Brush.Bg2}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="10,6">
      <TextBlock Text="G-CODE"
                 Classes="section"
                 Margin="0"
                 VerticalAlignment="Center"/>
    </Border>

    <!-- controls -->
    <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="10,10,10,0">

      <TextBlock Text="Post-processor" Classes="muted"/>
      <ComboBox x:Name="CbPost" HorizontalAlignment="Stretch"/>

      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button x:Name="BtnGenerate"
                Content="Generate G-code"
                Theme="{StaticResource Btn.Primary}"
                Click="OnGenerate"
                Padding="10,5"/>
        <Button x:Name="BtnSave"
                Content="Save file…"
                Theme="{StaticResource Btn.Ghost}"
                Click="OnSaveFile"
                Padding="10,5"/>
        <Button x:Name="BtnEditToggle"
                Content="Edit"
                Theme="{StaticResource Btn.Ghost}"
                Click="OnEditToggle"
                Padding="10,5"
                ToolTip.Tip="Toggle editable mode"/>
      </StackPanel>

      <!-- Edit-mode actions (only visible in edit mode) -->
      <StackPanel x:Name="EditActions" Orientation="Horizontal" Spacing="6" IsVisible="False">
        <Button x:Name="BtnRegenerate"
                Content="Regenerate"
                Theme="{StaticResource Btn.Ghost}"
                Click="OnRegenerate"
                Padding="8,4"
                ToolTip.Tip="Discard edits and regenerate from current project"/>
        <Button x:Name="BtnApplyEdits"
                Content="Apply edits"
                Theme="{StaticResource Btn.Primary}"
                Click="OnApplyEdits"
                Padding="8,4"
                ToolTip.Tip="Use manually edited G-code when running the job"/>
        <TextBlock x:Name="EditHint"
                   Text="Editing — changes used on next Run"
                   Classes="muted" FontSize="{StaticResource Font.Xs}"
                   VerticalAlignment="Center"/>
      </StackPanel>

      <TextBlock x:Name="TbStats"
                 Text="{Binding GcodeStats}"
                 Classes="muted"
                 IsVisible="{Binding GcodeStats.Length}"/>
    </StackPanel>

    <!-- G-code preview (editable with syntax coloring in read-only) -->
    <ScrollViewer x:Name="SvHighlight" Margin="0,8,0,0" IsVisible="True">
      <ItemsControl x:Name="SyntaxLines"
                    Background="{StaticResource Brush.Bg3}"
                    Padding="8"/>
    </ScrollViewer>
    <ScrollViewer x:Name="SvEdit" Margin="0,8,0,0" IsVisible="False">
      <TextBox x:Name="TbEdit"
               AcceptsReturn="True"
               Background="{StaticResource Brush.Bg3}"
               BorderThickness="0"
               FontFamily="Courier New, Consolas, monospace"
               FontSize="{StaticResource Font.Sm}"
               Foreground="{StaticResource Brush.Text}"
               Padding="8"/>
    </ScrollViewer>

  </DockPanel>

</UserControl>
